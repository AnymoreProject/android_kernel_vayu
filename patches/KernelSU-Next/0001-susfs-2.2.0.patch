diff --git a/kernel/Kconfig b/kernel/Kconfig
index c770166..133f906 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -35,4 +35,61 @@ config KSU_DISABLE_POLICY
 	  Escalation will always use the default full root profile, and
 	  non-root handling will follow the global umount policy only.
 
+menu "KernelSU - SuSFS"
+
+config KSU_SUSFS
+	bool "KernelSU addon - SuSFS"
+	depends on KSU
+	depends on THREAD_INFO_IN_TASK
+	default y
+	help
+	  Enable the SuSFS integration used by KernelSU.
+
+config KSU_SUSFS_SUS_PATH
+	bool "Hide suspicious paths"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "Hide suspicious mounts"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "Spoof suspicious kstat values"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "Spoof uname"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "Enable SuSFS logging"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "Hide KernelSU and SuSFS symbols"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "Spoof cmdline or bootconfig"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "Redirect opened paths"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_MAP
+	bool "Hide suspicious memory maps"
+	depends on KSU_SUSFS
+	default n
+
+endmenu
+
 endmenu
